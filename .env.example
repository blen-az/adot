# Hosted Postgres connection string. Leave unset to use embedded PGlite in DATA_DIR.
# DATABASE_URL=postgres://user:password@host:5432/adot

# Local database and uploads. Keep this outside OneDrive: syncing live database files can corrupt them.
# Defaults to ~/.adot-dev
# DATA_DIR=

# Comma-separated staff addresses for enquiry notifications.
ENQUIRY_NOTIFY_TO=leasing@example.com

# Set to 1 to simulate a mail outage (UAT-05).
MAIL_SIMULATE_FAILURE=0

# Required by /api/cron/notifications, which retries failed notifications.
CRON_SECRET=

# Used by npm run db:seed. If unset, the seed generates a password and prints it.
# SEED_PASSWORD=

# Powers the Ask Adot assistant. Keep it server-side. Without it, visitors see the fallback message.
# GEMINI_API_KEY=

# Image storage for hosts without a persistent disk (Vercel). Set both to store uploads on Cloudinary
# through an unsigned upload preset; leave unset to store them in DATA_DIR.
# The preset must not add a folder prefix to the public ID.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_UPLOAD_PRESET=
